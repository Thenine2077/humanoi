<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF ของหุ่นเต็มตัว (ฐาน mecanum + ลำตัวบนสองแขน — urdf/humanoi_full.urdf.xacro)

     กลุ่ม left_arm / right_arm / both_arms, ท่า rest และคู่ลิงก์ที่ไม่ต้องเช็กชนของแขน/เสา/มือ
     ดึงจาก SRDF ของระบบแขนจริง (ar_dual/srdf/humanoi_arms.srdf) ตรงๆ ไม่คัดลอกซ้ำ
     ไฟล์นี้เพิ่มเฉพาะคู่ที่เกิดจากการวางลำตัวบนแผ่นฐาน

       xacro humanoi_full.srdf.xacro -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="humanoi">

  <xacro:include filename="$(find ar_dual)/srdf/humanoi_arms.srdf"/>

  <!-- เสายึดกับแผ่นฐาน · ฐานแขนอยู่สูง 1.45 m แตะแผ่นฐานไม่ได้
       ยังเช็กแขน/มือกับแผ่นฐานตามปกติ (ล้อกับไลดาร์ไม่มีรูปทรงชน) -->
  <disable_collisions link1="chassis_link" link2="torso" reason="Adjacent"/>
  <disable_collisions link1="chassis_link" link2="left_base_link" reason="Never"/>
  <disable_collisions link1="chassis_link" link2="right_base_link" reason="Never"/>
  <disable_collisions link1="chassis_link" link2="left_link_1" reason="Never"/>
  <disable_collisions link1="chassis_link" link2="right_link_1" reason="Never"/>

</robot>
