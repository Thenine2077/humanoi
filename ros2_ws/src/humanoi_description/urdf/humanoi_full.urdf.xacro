<?xml version="1.0"?>
<!-- หุ่น Humanoi เต็มตัวสำหรับ Gazebo = ฐาน mecanum + เสา หัว กล้อง + แขน AR4 สองข้าง + มือ AmazingHand

  ประกอบจากไฟล์ที่ใช้กับของจริงทั้งหมด แก้ขนาดที่ต้นทางที่เดียว:
    - mecanum_base.urdf.xacro         (ของเรา — แผ่นฐาน ล้อ ไลดาร์ ปลั๊กอิน gz ของฐาน)
    - ar_dual/urdf/humanoi_upper.xacro (ของเรา ใน repo ar4 — เสา หัว กล้อง สองแขน มือ: ไฟล์เดียวกับระบบแขนจริง)
    - ar_dual/urdf/arm_control.xacro   (ros2_control ต่อแขน — ใช้แบบ gz ที่นี่)
    - config/camera_to_left_arm.yaml   (ตำแหน่งกล้องจาก hand-eye calibration — ไฟล์เดียวกับที่ yolo.launch.py ใช้)

    xacro humanoi_full.urdf.xacro

  แขนสั่งด้วย left_arm_controller / right_arm_controller ชื่อเดียวกับแขนจริง (ar_dual/config/controllers.yaml)
  MoveIt + ตัวเล่นโปรแกรม (ar_program) จึงใช้กับซิมได้เลยโดยไม่ต้องแก้

  ⚠️ ฐานยังขับด้วยปลั๊กอิน VelocityControl แบบ kinematic (ล้อไม่หมุนจริง) — ฐานไม่เอียง/ไม่คว่ำ
     ตามน้ำหนักแขน ใช้ดูท่า ระยะเอื้อม การชน และภาพกล้องได้ แต่ยังตอบเรื่องเสถียรภาพไม่ได้
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="humanoi">

  <xacro:arg name="controllers" default="$(find ar_dual)/config/controllers.yaml"/>
  <xacro:arg name="camera_yaml" default="$(find humanoi_description)/config/camera_to_left_arm.yaml"/>

  <xacro:include filename="$(find humanoi_description)/urdf/mecanum_base.urdf.xacro"/>
  <xacro:include filename="$(find ar_dual)/urdf/humanoi_upper.xacro"/>
  <xacro:include filename="$(find ar_dual)/urdf/arm_control.xacro"/>

  <!-- ลำตัวบน: เสาอยู่กึ่งกลางฐานทั้งหน้า-หลัง (หน้าเสาห่างขอบหน้าฐาน 20.5 cm = G, ฐานยาว 51 cm)
       และซ้าย-ขวา · หัวไหล่สูงจากพื้น up_shoulder_z -->
  <joint name="torso_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="torso"/>
    <origin xyz="${-up_pole_dx} 0 ${up_shoulder_z - wheel_radius - clearance}" rpy="0 0 0"/>
  </joint>
  <xacro:humanoi_upper left_hand="true" right_hand="true"/>
  <xacro:arm_control prefix="left_" hw="gz"/>
  <xacro:arm_control prefix="right_" hw="gz"/>

  <!-- ===================== กล้อง Astra Pro จำลอง =====================
       camera_link อยู่ตรงตำแหน่งที่ hand-eye calibration วัดได้ (เทียบฐานแขนซ้าย)
       ภาพสี 640x480 ค่าเลนส์ที่ calibrate จริง (config/astra_color.yaml): fx 631.98 fy 633.19 cx 321.59 cy 229.81
       horizontal_fov = 2·atan(320/631.98) — ไม่รวมความบิดเบี้ยวเลนส์ (k1, k2)
       ความลึก 0.6–8 m เหมือนตัวจริง (ใกล้กว่า 0.6 m วัดไม่ได้)
       สมมติว่าเฟรมภาพสีของไดรเวอร์จริงทับกับ camera_link (ไดรเวอร์ไม่มีค่าโรงงานของกล้องตัวนี้) -->
  <xacro:property name="cam_file" value="$(arg camera_yaml)"/>
  <xacro:property name="cam" value="${xacro.load_yaml(cam_file)}"/>
  <xacro:property name="cam_roll"
    value="${atan2(2 * (cam['qw'] * cam['qx'] + cam['qy'] * cam['qz']), 1 - 2 * (cam['qx'] ** 2 + cam['qy'] ** 2))}"/>
  <xacro:property name="cam_pitch"
    value="${asin(max(-1.0, min(1.0, 2 * (cam['qw'] * cam['qy'] - cam['qz'] * cam['qx']))))}"/>
  <xacro:property name="cam_yaw"
    value="${atan2(2 * (cam['qw'] * cam['qz'] + cam['qx'] * cam['qy']), 1 - 2 * (cam['qy'] ** 2 + cam['qz'] ** 2))}"/>

  <joint name="camera_joint" type="fixed">
    <parent link="${cam['parent_frame']}"/>
    <child link="camera_link"/>
    <origin xyz="${cam['x']} ${cam['y']} ${cam['z']}" rpy="${cam_roll} ${cam_pitch} ${cam_yaw}"/>
  </joint>
  <link name="camera_link"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <gazebo reference="camera_link">
    <!-- gz มองตามแกน +X ของ camera_link · ข้อความใน ROS ใช้เฟรม optical แบบเดียวกับไดรเวอร์จริง -->
    <sensor name="astra" type="rgbd_camera">
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <topic>camera</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>0.93742</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <lens>
          <intrinsics>
            <fx>631.98</fx>
            <fy>633.19</fy>
            <cx>321.59</cx>
            <cy>229.81</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.6</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>

</robot>
