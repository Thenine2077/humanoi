<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>humanoi_games</name>
  <version>0.0.1</version>
  <description>เกมสนุกๆ ของหุ่น Humanoi — เป่ายิ้งฉุบด้วยแขน AR4 + มือ AmazingHand + กล้อง</description>
  <maintainer email="nayzalovehrk@gmail.com">User</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ar_program</exec_depend>
  <exec_depend>humanoi_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- ไม่มีใน apt — ติดตั้งด้วย pip (ดู docs/RPS_GAME.md): rustypot (มือ), mediapipe 1.1.1 (ตาดูมือผู้เล่น) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
